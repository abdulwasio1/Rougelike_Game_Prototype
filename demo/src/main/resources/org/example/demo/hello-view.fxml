<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.canvas.Canvas?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.demo.HelloController">

   <Canvas fx:id="canvas"
           height="600.0"
           width="600.0"
           AnchorPane.leftAnchor="0.0"
           AnchorPane.topAnchor="0.0" />

   <!-- Score -->
   <Label fx:id="score"
          layoutX="504.0"
          layoutY="44.0"
          text="Score: 0"
          textFill="#90ff00">
      <font>
         <Font name="Arial Rounded MT Bold" size="14.0" />
      </font>
   </Label>

   <!-- Health -->
   <Label fx:id="healthLabel"
          layoutX="20.0"
          layoutY="20.0"
          text="Health: 100"
          textFill="RED">
      <font>
         <Font name="Arial Rounded MT Bold" size="14.0" />
      </font>
   </Label>

   <!-- Energy -->
   <Label fx:id="energyLabel"
          layoutX="20.0"
          layoutY="45.0"
          text="Energy: 100"
          textFill="DODGERBLUE">
      <font>
         <Font name="Arial Rounded MT Bold" size="14.0" />
      </font>
   </Label>

   <!-- Coins -->
   <Label fx:id="coinsLabel"
          layoutX="20.0"
          layoutY="70.0"
          text="Coins: 0"
          textFill="GOLD">
      <font>
         <Font name="Arial Rounded MT Bold" size="14.0" />
      </font>
   </Label>

</AnchorPane>
